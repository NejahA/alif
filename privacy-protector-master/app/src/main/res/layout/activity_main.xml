<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header Title -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:text="@string/app_name"
            android:textColor="@color/sacred_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Status Banner -->
        <LinearLayout
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_banner_protected"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info_black_24dp"
                android:tint="@color/emerald_shield" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.1"
                android:text="@string/status_protected"
                android:textColor="@color/emerald_shield"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Device Admin Warning Banner -->
        <LinearLayout
            android:id="@+id/admin_warning_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_admin_banner"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/admin_banner_title"
                android:textColor="@color/sacred_gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_activate_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gold_button"
                android:text="@string/btn_activate_admin"
                android:textColor="@color/obsidian_black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Central Illuminati Eye Node -->
        <LinearLayout
            android:id="@+id/master_eye_container"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_master_eye_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/master_eye_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_illuminati_eye" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="@string/tap_eye_hint"
            android:textColor="@color/text_white_70"
            android:textSize="11sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- 3-Card Row for Cam, Mic, Vol Traps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Cam Seal Card -->
            <LinearLayout
                android:id="@+id/card_cam_seal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_slate_card_cam_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="18dp"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/icon_cam_seal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/emerald_shield" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cam_seal_title"
                    android:textColor="@color/sacred_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_cam_seal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_blocked"
                    android:textColor="@color/emerald_shield"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mic Seal Card -->
            <LinearLayout
                android:id="@+id/card_mic_seal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_slate_card_mic_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="18dp"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/icon_mic_seal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mic_none_black_24dp"
                    android:tint="@color/cyber_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mic_seal_title"
                    android:textColor="@color/sacred_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_mic_seal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_blocked"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Vol Trap Card -->
            <LinearLayout
                android:id="@+id/card_vol_trap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_slate_card_vol_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="18dp"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/icon_vol_trap"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_touch_app_black_24dp"
                    android:tint="@color/amber_glow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/vol_trap_title"
                    android:textColor="@color/sacred_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_vol_trap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_trapped"
                    android:textColor="@color/amber_glow"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Intercepted Attempts Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_slate_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_info_black_24dp"
                android:tint="@color/sacred_gold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/threat_stats_title"
                    android:textColor="@color/sacred_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/threat_stats_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="14 Spyware Probe Attacks Neutralized"
                    android:textColor="@color/text_white_70"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
