{
  "name": "alif-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Unified workspace for Alif projects, mobile apps, web suites, arcade games, and backend services.",
  "scripts": {
    "dev:desktop": "cd alif/desktop && npm run tauri dev",
    "build:desktop": "cd alif/desktop && npm run build",
    "dev:game": "cd banjoui && npm run dev",
    "build:game": "cd banjoui && npm run build",
    "dev:web": "cd Alpalin/alpalin-web && npm run dev",
    "build:web": "cd Alpalin/alpalin-web && npm run build",
    "dev:mobile": "cd AlpalinMobile && npx expo start",
    "dev:mahdia": "cd alif/mahdia-react && npm run dev",
    "build:mahdia": "cd alif/mahdia-react && npm run build",
    "server:start": "cd Alpalin/server && node index.js",
    "build:all": "npm run build:desktop && npm run build:game && npm run build:web && npm run build:mahdia"
  },
  "devDependencies": {
    "electron-updater": "^6.8.11"
  },
  "dependencies": {
    "antd": "^6.7.1",
    "axe-core": "^4.14.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "express-rate-limit": "^8.7.4",
    "file-saver": "^2.0.5",
    "i18next": "^26.7.2",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "nodemailer": "^10.6.0",
    "react-i18next": "^17.1.13"
  }
}
