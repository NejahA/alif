{
  "main": "electron/main.cjs",
  "name": "alpalin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.7.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alpalin.desktop",
    "productName": "Alpalin",
    "icon": "build/icon.png",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/main.cjs", "build/icon.*"],
    "win": { "target": ["nsis", "zip"], "icon": "build/icon.ico" },
    "mac": { "target": ["dmg", "zip"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
