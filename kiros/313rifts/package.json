{
  "name": "313rifts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "prepare-icons": "node scripts/convert-icon.js",
    "test": "echo \"No tests specified\""
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.313rifts.app",
    "productName": "313rifts",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    }
  }
}