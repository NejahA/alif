#include "Resource.h"

// Application icon
IDI_APP_ICON ICON "app.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SysMonitor Project"
            VALUE "FileDescription", "System Monitor Application"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SysMonitor"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "SysMonitor.exe"
            VALUE "ProductName", "SysMonitor"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Menu resource
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Refresh\tF5", IDM_VIEW_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Always on Top", IDM_VIEW_ALWAYSONTOP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", IDM_HELP_ABOUT
    END
END

// String table
STRINGTABLE
BEGIN
    IDS_APP_TITLE      "SysMonitor - System Information"
    IDS_CPU_USAGE      "CPU Usage"
    IDS_MEMORY_USAGE   "Memory Usage"
    IDS_DISK_USAGE     "Disk Usage"
    IDS_NETWORK_USAGE  "Network Usage"
    IDS_PROCESSES      "Running Processes"
    IDS_REFRESH        "Refresh"
    IDS_EXIT           "Exit"
    IDS_ABOUT_TEXT     "SysMonitor v1.0\n\nA system monitoring tool for Windows\n\nCreated with C++ and WinAPI"
END

// About dialog
IDD_ABOUT_DIALOG DIALOGEX 0, 0, 200, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SysMonitor"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "SysMonitor", -1, 10, 10, 180, 20, SS_CENTER
    LTEXT           "Version 1.0", -1, 10, 30, 180, 20, SS_CENTER
    LTEXT           "A system monitoring tool for Windows", -1, 10, 50, 180, 20, SS_CENTER
    LTEXT           "Created with C++ and WinAPI", -1, 10, 70, 180, 20, SS_CENTER
    DEFPUSHBUTTON   "OK", IDOK, 75, 95, 50, 14
END