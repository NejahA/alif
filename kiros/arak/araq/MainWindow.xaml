<Window x:Class="araq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:araq"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Araq PDF" Height="800" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="12" Background="#1A1A1B" BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="ARAQ" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0" 
                           Foreground="#E1E1E1" FontWeight="SemiBold" FontSize="14"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="&#xE838;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#00D4FF" BorderThickness="0" Width="40" Height="40" Click="OpenNew_Click" Cursor="Hand" ToolTip="Open PDF"/>
                    <Button Content="&#xE949;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Width="40" Height="40" Click="Minimize_Click" Cursor="Hand"/>
                    <Button Content="&#xE739;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Width="40" Height="40" Click="Maximize_Click" Cursor="Hand"/>
                    <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#FF4B4B" BorderThickness="0" Width="40" Height="40" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- PDF Viewer Content -->
            <wv2:WebView2 x:Name="webView" Grid.Row="1" Margin="1" AllowDrop="True" Drop="DropOverlay_Drop" Visibility="Hidden" />
            
            <!-- Drop Overlay (Visible when no file is loaded) -->
            <Grid x:Name="DropOverlay" Grid.Row="1" Background="#1A1A1B" Visibility="Visible" AllowDrop="True" Drop="DropOverlay_Drop">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#555555" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop a PDF file here to read" Foreground="#888888" Margin="0,20,0,0" FontSize="16"/>
                    <Button Content="Open File" Margin="0,20,0,0" Padding="20,10" Background="#333333" Foreground="White" BorderThickness="0" Click="OpenFile_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
