#include "resource.h"
#include <windows.h>
#include <commctrl.h>

// Icons
IDI_AUDIOMASTER_ICON       ICON    "app.ico"
IDI_VOLUME_ICON            ICON    "volume.ico"
IDI_MUTE_ICON              ICON    "mute.ico"
IDI_DEVICE_ICON            ICON    "device.ico"
IDI_EQUALIZER_ICON         ICON    "equalizer.ico"
IDI_PEAKMETER_ICON         ICON    "peakmeter.ico"

// Cursors
IDC_VOLUME_CURSOR          CURSOR  "volume.cur"

// Bitmaps
IDB_MAIN_BACKGROUND        BITMAP  "background.bmp"
IDB_PEAK_METER             BITMAP  "peakmeter.bmp"
IDB_VOLUME_SLIDER          BITMAP  "slider.bmp"
IDB_EQUALIZER_BANDS        BITMAP  "equalizer.bmp"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AudioMaster Project"
            VALUE "FileDescription", "AudioMaster - Windows Audio Control Panel"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AudioMaster"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "AudioMaster.exe"
            VALUE "ProductName", "AudioMaster"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Comments", "Complete Windows audio control application"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Main menu
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Profile",                  ID_FILE_NEW_PROFILE
        MENUITEM "&Load Profile",                 ID_FILE_LOAD_PROFILE
        MENUITEM "&Save Profile",                 ID_FILE_SAVE_PROFILE
        MENUITEM SEPARATOR
        MENUITEM "&Import Settings",              ID_FILE_IMPORT
        MENUITEM "&Export Settings",              ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                         ID_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Always on Top",                ID_VIEW_ALWAYSONTOP, CHECKED
        MENUITEM "&Show Peak Meters",             ID_VIEW_SHOWPEAKS, CHECKED
        MENUITEM "&Show Device Panel",            ID_VIEW_SHOWDEVICES, CHECKED
        MENUITEM "&Show Session Panel",           ID_VIEW_SHOWSESSIONS, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&Compact Mode",                 ID_VIEW_COMPACT
        MENUITEM "&Full Mode",                    ID_VIEW_FULL
        MENUITEM SEPARATOR
        MENUITEM "&Refresh",                      ID_VIEW_REFRESH
    END
    POPUP "&Devices"
    BEGIN
        MENUITEM "&Playback Devices",             ID_DEVICES_PLAYBACK
        MENUITEM "&Recording Devices",            ID_DEVICES_RECORDING
        MENUITEM SEPARATOR
        MENUITEM "&Set Default Device",           ID_DEVICES_SETDEFAULT
        MENUITEM "&Device Properties",            ID_DEVICES_PROPERTIES
        MENUITEM "&Audio Enhancements",           ID_DEVICES_ENHANCEMENTS
    END
    POPUP "&Effects"
    BEGIN
        MENUITEM "&Equalizer",                    ID_EFFECTS_EQUALIZER
        MENUITEM "&Compressor",                   ID_EFFECTS_COMPRESSOR
        MENUITEM "&Reverb",                       ID_EFFECTS_REVERB
        MENUITEM "&Bass Boost",                   ID_EFFECTS_BASSBOOST
        MENUITEM "&Virtual Surround",             ID_EFFECTS_SURROUND
        MENUITEM SEPARATOR
        MENUITEM "&Noise Suppression",            ID_EFFECTS_NOISESUPPRESSION
        MENUITEM "&Echo Cancellation",            ID_EFFECTS_ECHOCANCELLATION
        MENUITEM "&Room Correction",              ID_EFFECTS_ROOMCORRECTION
    END
    POPUP "&Routing"
    BEGIN
        MENUITEM "&Application Routing",          ID_ROUTING_APPLICATIONS
        MENUITEM "&Device Routing",               ID_ROUTING_DEVICES
        MENUITEM SEPARATOR
        MENUITEM "&Create Routing Rule",          ID_ROUTING_CREATE
        MENUITEM "&Manage Rules",                 ID_ROUTING_MANAGE
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Audio Mixer",                  ID_TOOLS_MIXER
        MENUITEM "&Audio Recorder",               ID_TOOLS_RECORDER
        MENUITEM "&Audio Player",                 ID_TOOLS_PLAYER
        MENUITEM "&Audio Converter",              ID_TOOLS_CONVERTER
        MENUITEM SEPARATOR
        MENUITEM "&Audio Analyzer",               ID_TOOLS_ANALYZER
        MENUITEM "&Silence Detector",             ID_TOOLS_SILENCEDETECTOR
        MENUITEM "&Audio Normalizer",             ID_TOOLS_NORMALIZER
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&General",                      ID_SETTINGS_GENERAL
        MENUITEM "&Hotkeys",                      ID_SETTINGS_HOTKEYS
        MENUITEM "&Notifications",                ID_SETTINGS_NOTIFICATIONS
        MENUITEM "&Audio Quality",                ID_SETTINGS_QUALITY
        MENUITEM SEPARATOR
        MENUITEM "&Backup Settings",              ID_SETTINGS_BACKUP
        MENUITEM "&Restore Settings",             ID_SETTINGS_RESTORE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&User Guide",                   ID_HELP_GUIDE
        MENUITEM "&Keyboard Shortcuts",           ID_HELP_SHORTCUTS
        MENUITEM SEPARATOR
        MENUITEM "&Check for Updates",            ID_HELP_UPDATES
        MENUITEM SEPARATOR
        MENUITEM "&About AudioMaster",            ID_HELP_ABOUT
    END
END

// Accelerators
IDR_MAIN_ACCELERATORS ACCELERATORS
BEGIN
    "^N",           ID_FILE_NEW_PROFILE,      VIRTKEY, CONTROL
    "^O",           ID_FILE_LOAD_PROFILE,     VIRTKEY, CONTROL
    "^S",           ID_FILE_SAVE_PROFILE,     VIRTKEY, CONTROL
    VK_F5,          ID_VIEW_REFRESH,          VIRTKEY
    VK_F1,          ID_HELP_GUIDE,            VIRTKEY
    VK_F12,         ID_HELP_ABOUT,            VIRTKEY
END

