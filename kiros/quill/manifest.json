{
    "manifest_version": 3,
    "name": "Quill - Daily Writing",
    "version": "1.0.0",
    "description": "A minimal, distraction-free writing app for your daily thoughts",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Open Quill"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}
