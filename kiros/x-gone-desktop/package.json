{
  "name": "x-gone-desktop",
  "version": "1.0.0",
  "description": "X-Gone Desktop Application - Ephemeral Workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build": "electron-builder --win nsis",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "x-gone",
    "desktop",
    "ephemeral",
    "mongodb"
  ],
  "author": "Kiros",
  "license": "ISC",
  "build": {
    "appId": "com.kiros.xgone",
    "productName": "X-Gone",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "X-Gone",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "models/**/*",
      "logo.png",
      "icon.png",
      "icon.ico",
      "package.json",
      ".env"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "mongoose": "^9.4.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
