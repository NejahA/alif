{
  "name": "Ollama Chat - Working",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "ollama-working",
      "parameters": {
        "path": "ollama/working",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "name": "Call Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 300],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/generate",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "llama3.2:1b"},
            {"name": "prompt", "value": "={{ $json.body.prompt }}"},
            {"name": "stream", "value": false}
          ]
        },
        "options": {},
        "sendQuery": false,
        "sendHeaders": false
      }
    },
    {
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Call Ollama", "type": "main", "index": 0}]]
    },
    "Call Ollama": {
      "main": [[{"node": "Respond", "type": "main", "index": 0}]]
    }
  },
  "settings": {},
  "staticData": null,
  "pinData": {},
  "versionId": "",
  "active": false
}