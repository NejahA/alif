{
  "id": "ollama-chat-webhook",
  "name": "Ollama Chat Webhook",
  "nodes": [
    {
      "id": "310106d6-3dd6-4a40-b865-3927e68d267e",
      "parameters": {
        "path": "ollama/chat",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "name": "Webhook"
    },
    {
      "id": "8fa9b992-b4e8-426b-829e-c4f9706fa362",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "\"llama3.2:1b\""
            },
            {
              "name": "prompt",
              "value": "={{ $json.body.prompt }}"
            },
            {
              "name": "stream",
              "value": "false"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        550,
        300
      ],
      "name": "Call Ollama"
    },
    {
      "id": "16fd905e-5b55-4107-98ec-d79631a1e49c",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.response }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "name": "Respond"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Ollama": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "pinData": {},
  "active": false
}